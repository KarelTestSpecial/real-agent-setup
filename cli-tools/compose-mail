#!/usr/bin/env python3
"""compose-mail — build a correct outgoing e-mail and save it as a Gmail draft via himalaya.

WHY THIS EXISTS
    Hand-rolling raw .eml messages for `himalaya message save` repeatedly caused
    two failure modes:
      1. Long plain-text lines got truncated by Gmail's SMTP on send.
      2. Plain-text bodies render in a narrow, "cut-off"-looking column in Gmail.
    This tool removes the hand-work: it ALWAYS produces
        multipart/mixed[ multipart/alternative[ text/plain(QP), text/html ], <attachments> ]
    so the body reflows wide (HTML) and never truncates (quoted-printable), with
    attachments embedded and correct reply threading.

    It ONLY saves a DRAFT (never sends) — sending stays a human action (HITL).

USAGE
    compose-mail --account gmail-personal \
        --to someone@example.com \
        --subject "Onderwerp" \
        --body-file /path/body.txt \
        [--attach /abs/path/file.pdf ...] \
        [--in-reply-to '<message-id>'] [--reply] \
        [--from you@example.com] [--folder '[Gmail]/Concepten']

    Body: paragraphs separated by blank lines; single newlines inside a paragraph
    become <br> (handy for signatures). Pass either --body-file or --body.
    Inline ``**bold**`` is rendered as <strong>. Everything else is escaped, so
    no raw HTML or markdown ever reaches the body.
"""
import argparse
import json
import mimetypes
import re
import shutil
import subprocess
import sys
from email.message import EmailMessage
from html import escape
from pathlib import Path

# Stable account -> From address map (see CLAUDE.md Himalaya section).
# Kept OUTSIDE the script so every published copy stays PII-free: the script
# ships with example addresses, each install points at its own local file.
ACCOUNTS_FILE = Path.home() / ".config" / "maccha" / "accounts.json"


def load_accounts() -> dict:
    if not ACCOUNTS_FILE.is_file():
        sys.exit(
            f"ERROR: {ACCOUNTS_FILE} not found.\n"
            '       Expected a JSON object mapping himalaya accounts to From\n'
            '       addresses, e.g. {"gmail-personal": "you@example.com"}.'
        )
    try:
        data = json.loads(ACCOUNTS_FILE.read_text())
    except json.JSONDecodeError as e:
        sys.exit(f"ERROR: invalid JSON in {ACCOUNTS_FILE}: {e}")
    if not isinstance(data, dict) or not data:
        sys.exit(f"ERROR: {ACCOUNTS_FILE} must be a non-empty JSON object.")
    return data


ACCOUNT_FROM = load_accounts()


def find_himalaya() -> str:
    local = Path.home() / ".local/bin/himalaya"
    if local.is_file():
        return str(local)
    found = shutil.which("himalaya")
    if found:
        return found
    sys.exit("ERROR: himalaya binary not found (looked in ~/.local/bin and PATH).")


BODY_STYLE = "font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;color:#222;"
# Explicit margins: a bare <p> gets ~1em top AND bottom from the mail client, which
# stacks into visibly doubled spacing between blocks. Pin it instead.
P_STYLE = "margin:0 0 12px 0;line-height:1.45;"


def inline_markup(escaped_line: str) -> str:
    """Turn a tiny markdown subset into HTML on an ALREADY-escaped line.

    Only ``**bold**`` is supported. Escape happens first, so this can never
    inject markup: ``*``, ``<``, ``>`` and ``&`` are untouched by the
    substitution (the asterisks are literal, the angle brackets are already
    entities).
    """
    return re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", escaped_line)


def build_html(body: str) -> str:
    paragraphs = [p for p in body.split("\n\n")]
    html_paras = []
    for p in paragraphs:
        if not p.strip():
            continue
        html_paras.append(
            f'<p style="{P_STYLE}">'
            + "<br>".join(inline_markup(escape(line)) for line in p.split("\n"))
            + "</p>"
        )
    return (
        f'<html><body style="{BODY_STYLE}">\n' + "\n".join(html_paras) + "\n</body></html>\n"
    )


def main() -> None:
    ap = argparse.ArgumentParser(description="Build an HTML+QP e-mail and save it as a himalaya draft.")
    ap.add_argument("--account", required=True, help="himalaya account (e.g. gmail-personal)")
    ap.add_argument("--to", required=True)
    ap.add_argument("--subject", required=True)
    ap.add_argument("--from", dest="from_addr", help="From address (default: derived from --account)")
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--body")
    g.add_argument("--body-file")
    ap.add_argument("--attach", action="append", default=[], help="absolute path to an attachment (repeatable)")
    ap.add_argument("--in-reply-to", help="Message-ID of the mail being replied to (enables threading)")
    ap.add_argument("--references", help="References header (default: same as --in-reply-to)")
    ap.add_argument("--reply", action="store_true", help='prepend "Re: " to the subject if absent')
    ap.add_argument("--folder", default="[Gmail]/Concepten")
    ap.add_argument("--print-eml", action="store_true", help="write the .eml to stdout instead of saving")
    args = ap.parse_args()

    from_addr = args.from_addr or ACCOUNT_FROM.get(args.account)
    if not from_addr:
        sys.exit(f"ERROR: no --from given and account '{args.account}' is not in the known map.")

    body = Path(args.body_file).read_text(encoding="utf-8") if args.body_file else args.body
    subject = args.subject
    if args.reply and not subject.lower().startswith("re:"):
        subject = "Re: " + subject

    msg = EmailMessage()
    msg["From"] = from_addr
    msg["To"] = args.to
    msg["Subject"] = subject
    if args.in_reply_to:
        msg["In-Reply-To"] = args.in_reply_to
        msg["References"] = args.references or args.in_reply_to

    msg.set_content(body, subtype="plain", charset="utf-8")      # QP fallback, no truncation
    msg.add_alternative(build_html(body), subtype="html", charset="utf-8")  # wide reflow in Gmail

    for a in args.attach:
        p = Path(a)
        if not p.is_file():
            sys.exit(f"ERROR: attachment not found: {a}")
        ctype, _ = mimetypes.guess_type(p.name)
        maintype, subtype = (ctype.split("/", 1) if ctype else ("application", "octet-stream"))
        msg.add_attachment(p.read_bytes(), maintype=maintype, subtype=subtype, filename=p.name)

    raw = bytes(msg)
    if args.print_eml:
        sys.stdout.buffer.write(raw)
        return

    him = find_himalaya()
    res = subprocess.run(
        [him, "message", "save", "-a", args.account, "--folder", args.folder],
        input=raw, capture_output=True,
    )
    out = (res.stdout + res.stderr).decode("utf-8", "replace").strip()
    if res.returncode != 0:
        sys.exit(f"ERROR: himalaya message save failed:\n{out}")
    print(out or "Draft saved.")
    print(f"[compose-mail] HTML+QP draft with {len(args.attach)} attachment(s) saved to {args.folder} ({args.account}). NOT sent (HITL).")


if __name__ == "__main__":
    main()
