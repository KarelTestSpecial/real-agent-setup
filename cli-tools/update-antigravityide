#!/bin/bash
# ==============================================================================
# Script: update-antigravityide
# Goal: Intelligent installation of Google Antigravity IDE (Classic Editor)
#       Prevents namespace and Electron app.asar conflicts in Linux environments.
# ==============================================================================

set -eo pipefail # Guarantees immediate termination on a sub-command failure

ARCHIVE_PATH="$1"

# 1. Validate the input
if [[ -z "$ARCHIVE_PATH" || ! -f "$ARCHIVE_PATH" ]]; then
    echo "SYSTEM ERROR: no valid .tar.gz archive file specified."
    echo "Usage: update-antigravityide <path-to-tar.gz>"
    exit 1
fi

APP_NAME="Antigravity IDE (Classic Editor)"
TARGET_DIR="/opt/antigravity-ide"
BIN_NAME="antigravity-ide"

echo ">> Starting automated deployment for: $APP_NAME"
echo ">> Resolved target directory: $TARGET_DIR"

# 2. Defensive cleanup (crucial to prevent Electron conflicts)
echo ">> Removing outdated binaries and resource files..."
sudo rm -rf "$TARGET_DIR"
sudo mkdir -p "$TARGET_DIR"

# 3. Safe extraction
echo ">> Extracting the archive into the target directory..."
sudo tar -xzf "$ARCHIVE_PATH" -C "$TARGET_DIR" --strip-components=1

# 4. System integration: Creating symbolic links in the binary PATH structure
echo ">> Registering binary executables in /usr/bin..."
if [[ -f "$TARGET_DIR/bin/$BIN_NAME" ]]; then
    sudo ln -sf "$TARGET_DIR/bin/$BIN_NAME" "/usr/bin/$BIN_NAME"
else
    sudo ln -sf "$TARGET_DIR/$BIN_NAME" "/usr/bin/$BIN_NAME"
fi

# 5. System security: configure kernel-level sandboxing
if [[ -f "$TARGET_DIR/chrome-sandbox" ]]; then
    echo ">> Configuring root privileges for the nsjail / chrome-sandbox..."
    sudo chown root:root "$TARGET_DIR/chrome-sandbox"
    sudo chmod 4755 "$TARGET_DIR/chrome-sandbox"
fi

echo ">> SUCCESS: Installation of $APP_NAME completed."
