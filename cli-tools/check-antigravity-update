#!/bin/bash
# ==============================================================================
# Script: check-antigravity-update
# Goal: Checks the current version of Antigravity 2.0 (Agent Manager) against 
#       the latest available stable release, and offers the option
#       to run the upgrade immediately and safely.
# ==============================================================================

# UI colors
CYAN="\e[36m"
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
RED="\e[31m"
BOLD="\e[1m"
RESET="\e[0m"

echo -e "${CYAN}${BOLD}🔍 Antigravity 2.0 Agent Manager Update Checker & Installer${RESET}"
echo -e "======================================================================"

# 1. Determine the installed version via the built-in ASAR parser
echo -e "${BLUE}Analyzing installed app package...${RESET}"
INSTALLED_VERSION=$(node -e "
const fs = require('fs');
try {
    const fd = fs.openSync('/opt/antigravity/resources/app.asar', 'r');
    const buf = Buffer.alloc(16);
    fs.readSync(fd, buf, 0, 16, 0);
    const headerSize = buf.readUInt32LE(4);
    const jsonSize = buf.readUInt32LE(12);
    const headerBuf = Buffer.alloc(jsonSize);
    fs.readSync(fd, headerBuf, 0, jsonSize, 16);
    const header = JSON.parse(headerBuf.toString('utf8'));
    const pkgNode = header.files['package.json'];
    const offset = parseInt(pkgNode.offset, 10);
    const size = parseInt(pkgNode.size, 10);
    const payloadStart = 8 + headerSize;
    const fileBuf = Buffer.alloc(size);
    fs.readSync(fd, fileBuf, 0, size, payloadStart + offset);
    fs.closeSync(fd);
    console.log(JSON.parse(fileBuf.toString('utf8')).version);
} catch(e) {
    console.log('Not installed');
}
")

echo -e "${BLUE}Installed version:${RESET} ${BOLD}${INSTALLED_VERSION}${RESET}"

# 2. Fetch the latest available version via the API
API_URL="https://antigravity-auto-updater-974169037036.us-central1.run.app/releases"
echo -e "${BLUE}Fetching release information...${RESET}"

RELEASES_JSON=$(curl -sL "$API_URL")

if [ -z "$RELEASES_JSON" ] || [ "$RELEASES_JSON" == "[]" ]; then
    echo -e "${RED}❌ Error: Failed to connect to the update server or no releases found.${RESET}"
    exit 1
fi

# The API returns a sorted JSON array. The first entry is the newest release.
LATEST_VERSION=$(echo "$RELEASES_JSON" | jq -r '.[0].version')
EXEC_ID=$(echo "$RELEASES_JSON" | jq -r '.[0].execution_id')

echo -e "${BLUE}Latest available version:${RESET} ${BOLD}${LATEST_VERSION}${RESET}"

if [ "$INSTALLED_VERSION" == "Not installed" ]; then
    echo -e "${YELLOW}⚠️ Antigravity 2.0 is currently not correctly installed at /opt/antigravity.${RESET}"
    echo -e "You can install the latest version with:"
    echo -e "  ${GREEN}update-antigravity <path-to-tar.gz>${RESET}"
    exit 0
fi

# 3. Compare and report
if [ "$INSTALLED_VERSION" == "$LATEST_VERSION" ]; then
    echo -e "======================================================================"
    echo -e "${GREEN}✅ You are completely up-to-date! No action required.${RESET}"
    echo -e "Current version ${BOLD}${INSTALLED_VERSION}${RESET} is the latest stable release."
    echo -e "======================================================================"
    exit 0
fi

echo -e "======================================================================"
echo -e "${YELLOW}🚀 UPDATE AVAILABLE!${RESET}"
echo -e "A new stable release of Antigravity 2.0 is available."
echo -e "  • Current version : ${RED}${INSTALLED_VERSION}${RESET}"
echo -e "  • New version   : ${GREEN}${LATEST_VERSION}${RESET} (Build: ${EXEC_ID})"
echo ""

# Generate the download URL
DOWNLOAD_URL="https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/${LATEST_VERSION}-${EXEC_ID}/linux-x64/Antigravity.tar.gz"

echo -e "${BLUE}Official Google CDN download link:${RESET}"
echo -e "  ${CYAN}${DOWNLOAD_URL}${RESET}"
echo "======================================================================"

# Offer an interactive option to run the update immediately
read -p "Do you want to automatically download and install this update now? (y/n): " CONFIRM
CONFIRM=$(echo "$CONFIRM" | tr '[:upper:]' '[:lower:]')

if [[ "$CONFIRM" == "j" || "$CONFIRM" == "ja" || "$CONFIRM" == "y" || "$CONFIRM" == "yes" ]]; then
    echo -e "\n${CYAN}>> Starting the automated upgrade...${RESET}"
    
    TEMP_ARCHIVE="$HOME/Downloads/Antigravity_AgentManager.tar.gz"
    
    echo -e "${BLUE}>> Downloading the latest release to ${TEMP_ARCHIVE}...${RESET}"
    if wget -O "$TEMP_ARCHIVE" "$DOWNLOAD_URL"; then
        echo -e "${GREEN}>> Download completed!${RESET}"
        
        echo -e "${BLUE}>> Starting installation via update-antigravity...${RESET}"
        if update-antigravity "$TEMP_ARCHIVE"; then
            echo -e "${GREEN}>> Installation completed successfully!${RESET}"
        else
            echo -e "${RED}❌ Error: Installation via update-antigravity failed.${RESET}"
            exit 1
        fi
        
        echo -e "${BLUE}>> Cleaning up temporary archive file...${RESET}"
        rm -f "$TEMP_ARCHIVE"
        echo -e "${GREEN}>> Storage cleaned up. System is spick and span again!${RESET}"
        echo -e "\n${GREEN}🎉 Antigravity 2.0 was successfully upgraded to version ${LATEST_VERSION}!${RESET}"
    else
        echo -e "${RED}❌ Error: Downloading update failed.${RESET}"
        rm -f "$TEMP_ARCHIVE"
        exit 1
    fi
else
    echo -e "\n${YELLOW}Upgrade skipped.${RESET} You can do this manually later with:"
    echo -e "  ${GREEN}wget -O ~/Downloads/Antigravity_AgentManager.tar.gz \"${DOWNLOAD_URL}\"${RESET}"
    echo -e "  ${GREEN}update-antigravity ~/Downloads/Antigravity_AgentManager.tar.gz${RESET}"
    echo -e "  ${GREEN}rm ~/Downloads/Antigravity_AgentManager.tar.gz${RESET}"
fi
echo -e "======================================================================"
