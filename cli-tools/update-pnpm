#!/bin/bash
# ==============================================================================
# Script: update-pnpm
# Description: Updates pnpm to the newest version that respects the cooldown
#              from ~/.npmrc (minimum-release-age, in minutes; default 7 days).
#
# WHY THIS WAS REWRITTEN (2026-10-28)
#   The previous version delegated to `npm install -g pnpm@latest`. Two flaws:
#     1. `minimum-release-age` is a pnpm setting — npm reports it as an
#        "Unknown user config" and IGNORES it. The cooldown never applied, so
#        the script silently installed versions younger than 7 days.
#     2. npm's global prefix (the nvm node dir) is NOT where the pnpm binary on
#        PATH lives (~/.npm-global). The update landed in a directory that is
#        shadowed, so `pnpm -v` never changed: "the update does nothing".
#   Plus: the fallback loop ran one `npm view` per released version (hundreds
#   of registry calls) — it appeared to hang.
#
#   Fix: pick the target version from ONE `npm view pnpm time --json` call and
#   let pnpm update itself (`pnpm self-update <version>`), which always touches
#   the binary that is actually on PATH.
# ==============================================================================

set -euo pipefail

NPMRC="${HOME}/.npmrc"

# --- cooldown: read from .npmrc (minutes), default 7 days --------------------
COOLDOWN_MIN=$(grep -E '^[[:space:]]*minimum-release-age[[:space:]]*=' "$NPMRC" 2>/dev/null \
  | tail -1 | sed -E 's/.*=[[:space:]]*//' | tr -dc '0-9')
COOLDOWN_MIN="${COOLDOWN_MIN:-10080}"
COOLDOWN_DAYS=$(( COOLDOWN_MIN / 1440 ))

CURRENT=$(pnpm -v 2>/dev/null || echo "unknown")
echo "Installed pnpm:  $CURRENT"
echo "Cooldown:        ${COOLDOWN_DAYS} days (${COOLDOWN_MIN} min, from ~/.npmrc)"

# --- one registry call: dates + newest compliant target ----------------------
read -r LATEST LATEST_DATE TARGET TARGET_DATE < <(npm view pnpm time --json 2>/dev/null | \
  python3 -c "
import json, sys, datetime
try:
    d = json.load(sys.stdin)
except Exception:
    print('? ? ? ?'); raise SystemExit
now = datetime.datetime.now(datetime.timezone.utc)
cut = now - datetime.timedelta(minutes=$COOLDOWN_MIN)
stable = [(v, datetime.datetime.fromisoformat(t.replace('Z', '+00:00')))
          for v, t in d.items() if v not in ('created', 'modified') and '-' not in v]
if not stable:
    print('? ? ? ?'); raise SystemExit
stable.sort(key=lambda x: x[1])
latest, latest_dt = stable[-1]
ok = [x for x in stable if x[1] <= cut]
target = ok[-1] if ok else ('none', now)
print(latest, latest_dt.date(), target[0], target[1].date())
")

if [ "$LATEST" = "?" ]; then
  echo "ERROR: cannot read release dates from the npm registry."
  exit 1
fi

echo "Newest release:  $LATEST ($LATEST_DATE)"

if [ "$TARGET" = "none" ]; then
  echo "ERROR: no stable pnpm release is older than the cooldown."
  exit 1
fi

echo "Allowed now:     $TARGET ($TARGET_DATE)"

if [ "$CURRENT" = "$TARGET" ]; then
  echo ""
  echo "Already on the newest version the cooldown allows. Nothing to do."
  exit 0
fi

if [ "$CURRENT" = "$LATEST" ]; then
  echo ""
  echo "Already on the newest release; it is younger than the cooldown."
  echo "No action needed."
  exit 0
fi

echo ""
echo "Updating: $CURRENT -> $TARGET"
if ! pnpm self-update "$TARGET" --yes; then
  # Fallback: pnpm refuses (e.g. npm-installed pnpm). Install explicitly into
  # the prefix where the active binary lives — never npm's default (the nvm
  # node dir), because ~/.npm-global shadows it.
  echo ""
  echo "self-update failed; falling back to npm with explicit prefix ~/.npm-global"
  npm install -g --prefix "$HOME/.npm-global" "pnpm@$TARGET"
fi

# --- verify what is actually on PATH ----------------------------------------
NEW=$(pnpm -v 2>/dev/null || echo "unknown")
echo ""
if [ "$NEW" = "$TARGET" ]; then
  echo "OK: pnpm is now $NEW."
else
  echo "WARNING: pnpm reports $NEW, expected $TARGET."
  echo "Check which binary comes first on PATH:"
  type -a pnpm
  exit 1
fi

# --- warn when another copy on this system differs ---------------------------
while IFS= read -r bin; do
  path="${bin##* }"
  [ -x "$path" ] || continue
  ver=$("$path" --version 2>/dev/null || echo "?")
  [ "$ver" = "$NEW" ] || echo "  WARNING: other pnpm on this system: $path = $ver"
done < <(type -a pnpm 2>/dev/null | sed -n 's/^pnpm is //p')
