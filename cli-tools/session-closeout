#!/bin/bash
# Session Closeout: prune TMS + method-improver + integrity check
MEMANTO=~/bin/maccha/memanto_cli.py
TMS_PRUNE=~/INFRA/maintenance/tms_prune.js
INTEGRITY=~/bin/maccha/tms_integrity_hook.py

echo "========================================"
echo " SESSION CLOSEOUT"
echo "========================================"

# 1 TMS Prune
echo ""
echo "=== Step 1: TMS Pruning ==="
if [ -f "$TMS_PRUNE" ]; then
  node "$TMS_PRUNE" 2>/dev/null && echo "TMS pruned" || echo "TMS prune skipped"
else
  echo "tms_prune.js not found"
fi

# 2 Method Improver (self-reflection prompt)
echo ""
echo "=== Step 2: Method Improver ==="
echo "Reflect:"
echo "  - What went well this session?"
echo "  - What were repeated mistakes?"
echo "  - Are there lessons that meet the significance threshold?"
echo ""
echo "Usage: memanto_cli.py distill \"Title\" \"Content\" --category technical/strategic/security"

# 3 Integrity Hook
echo ""
echo "=== Step 3: TMS Integrity Check ==="
if [ -f "$INTEGRITY" ]; then
  python3 "$INTEGRITY" 2>&1
else
  echo "tms_integrity_hook.py not found"
fi

# 4 Scratch Cleanup
echo ""
echo "=== Step 4: Scratch Cleanup ==="
if [ -d "$HOME/scratch" ] && [ -n "$HOME" ]; then
  if [ "$(ls -A "$HOME/scratch" 2>/dev/null)" ]; then
    if [[ "$*" == *"--wipe-scratch"* ]]; then
      rm -rf "$HOME/scratch"
      mkdir -p "$HOME/scratch"
      echo "Scratch directory wiped clean"
    else
      echo "⚠️  WARNING: Scratch directory is not empty. Pass the --wipe-scratch flag to wipe it."
    fi
  else
    echo "Scratch directory is already empty."
  fi
else
  echo "Scratch directory not found or HOME variable unset"
fi

echo ""
echo "========================================"
echo " CLOSEOUT COMPLETED"
echo "========================================"
