#!/bin/bash
# Session Startup: prime context + verify state
MEMANTO=~/bin/maccha/memanto_cli.py
echo "=== PRIME: loading context ==="
"$MEMANTO" prime 2>/dev/null
echo ""
echo "=== TMS check ==="
# Rule guard (CLAUDE.md 1.b): warns only on violations, otherwise one OK line.
TMS_OK=true
for f in ~/todo.md ~/in-progress.md; do
  if [ ! -f "$f" ]; then
    echo "⚠️  $f missing — broken symlink to BRAIN?"
    TMS_OK=false
    continue
  fi
  X_COUNT=$(grep -c '^- \[x\]' "$f")
  if (( X_COUNT > 0 )); then
    echo "⚠️  $f contains $X_COUNT finished [x] item(s) — move each as a single line to done.md now"
    TMS_OK=false
  fi
done
if [ -f ~/in-progress.md ]; then
  IP_OPEN=$(grep -c '^- \[[ /]\]' ~/in-progress.md)
  if (( IP_OPEN > 10 )); then
    echo "⚠️  in-progress.md has $IP_OPEN open items (max ±10) — prune back to todo.md"
    TMS_OK=false
  fi
fi
# Limit in CHARACTERS (UTF-8 aware), not bytes: awk length() counts bytes, which
# differed by 20-40 characters per line for euro signs, dashes or emoji versus
# tms_integrity_hook.py. SINGLE source: ~/.config/maccha/tms_line_limit.json —
# also read by the closeout hook tms_integrity_hook.py and the plugin tms-line-limit.ts.
TMS_MAX_LINE=$(python3 -c '
import json, os
try:
    with open(os.path.expanduser("~/.config/maccha/tms_line_limit.json"), encoding="utf-8") as fh:
        print(int(json.load(fh)["max_line_chars"]))
except Exception:
    print(300)
' 2>/dev/null)
[ -n "$TMS_MAX_LINE" ] || TMS_MAX_LINE=300
LONG_LINES=$(python3 -c '
import sys
LIMIT = int(sys.argv[1])
for path in sys.argv[2:]:
    try:
        with open(path, encoding="utf-8") as fh:
            for nr, line in enumerate(fh, 1):
                line = line.rstrip("\n")
                if len(line) > LIMIT:
                    print(f"{path}:{nr} ({len(line)} chars)")
    except OSError:
        pass
' "$TMS_MAX_LINE" ~/todo.md ~/in-progress.md ~/backlog.md 2>/dev/null)
if [ -n "$LONG_LINES" ]; then
  echo "⚠️  Lines >${TMS_MAX_LINE} chars in TMS — move history to INFO/ and keep only next action + link:"
  echo "$LONG_LINES"
  TMS_OK=false
fi
if $TMS_OK; then
  echo "TMS OK (todo: $(grep -c '^- \[[ /]\]' ~/todo.md) open, in-progress: $(grep -c '^- \[[ /]\]' ~/in-progress.md) open)"
fi

echo ""

echo ""

echo ""
echo "=== Weekly TMS sweep (throttled, 1x per 7 days) ==="
SWEEP_MARKER=~/BRAIN/tms/.last_sweep
NOW=$(date +%s)
LAST=$(cat "$SWEEP_MARKER" 2>/dev/null || echo 0)
if (( NOW - LAST > 604800 )); then
  echo "$NOW" > "$SWEEP_MARKER"
  node ~/INFRA/maintenance/tms_prune.js
  echo "🧠 Pruning Memanto working memory (decayed Event noise)..."
  ~/bin/maccha/memanto_cli.py prune 2>/dev/null | grep -E 'Store:|Cleaned up' || true
  echo "⚠️  Weekly sweep due — manual steps for the agent:"
  echo "   move [x] items from todo/in-progress to done.md as single lines;"
  echo "   remove duplicates; in-progress.md max ±10 items; enforce the label format."
else
  echo "Last sweep $(( (NOW - LAST) / 86400 )) day(s) ago — OK."
fi

echo ""
echo "=== INBOX check ==="
# Untitled-1 = Users permanente kladblok (zie INBOX/README.md) — nooit tellen of opruimen.
INBOX_N=$(find ~/INBOX -mindepth 1 -not -name 'README.md' -not -name 'Untitled-1' 2>/dev/null | wc -l)
if (( INBOX_N > 0 )); then
  echo "📥 INBOX contains $INBOX_N item(s) — process to owner locations and empty the folder:"
  find ~/INBOX -mindepth 1 -not -name 'README.md' -not -name 'Untitled-1' | head -10
else
  echo "INBOX empty (kladblok Untitled-1 = permanent, buiten beschouwing)."
fi

echo ""
echo "=== Weekly encrypted backup (throttled, 1x per 7 days) ==="
BK_MARKER=~/BRAIN/.last_backup
LASTB=$(cat "$BK_MARKER" 2>/dev/null || echo 0)
if (( NOW - LASTB > 604800 )); then
  echo "Backup due — starting in the background (log: ~/scratch/maccha-backup.log)"
  nohup ~/bin/maccha/maccha-backup > ~/scratch/maccha-backup.log 2>&1 &
else
  echo "Last backup $(( (NOW - LASTB) / 86400 )) day(s) ago — OK."
fi

echo ""
echo "=== Weekly link check (throttled, 1x per 7 days) ==="
# Guards knowledge files against link rot after folder reorganizations.
# The throttle marker is only written after a CLEAN check: a broken link therefore
# keeps reporting on every start until it is repaired (a gate, not a report).
LC_MARKER=~/BRAIN/.last_linkcheck
LASTL=$(cat "$LC_MARKER" 2>/dev/null || echo 0)
if (( NOW - LASTL > 604800 )); then
  # Resolve each logical knowledge file to the layout present on this machine:
  # BRAIN/tms/<f> (personal layout) -> BRAIN/<f> -> ~/<f> (fresh capsule install,
  # where setup.sh puts the templates in the home directory).
  LC_TARGETS=()
  for f in AGENTS.md IMPROVEMENT.md todo.md in-progress.md backlog.md done.md; do
    for cand in "$HOME/BRAIN/tms/$f" "$HOME/BRAIN/$f" "$HOME/$f"; do
      if [ -f "$cand" ]; then LC_TARGETS+=("$cand"); break; fi
    done
  done
  if [ "${#LC_TARGETS[@]}" -eq 0 ]; then
    echo "link-check: no knowledge files found in this layout — skipped."
  elif node ~/BRAIN/hooks/link-check.cjs "${LC_TARGETS[@]}" 2>/dev/null; then
    echo "$NOW" > "$LC_MARKER"
  else
    echo "⚠️  link-check.cjs failed — throttle NOT advanced: this keeps reporting until fixed."
  fi
else
  echo "Last link check $(( (NOW - LASTL) / 86400 )) day(s) ago — OK."
fi

echo ""

# Readable todo view retired (User's decision, 5 October 2026).
# `todo.md` is the only place; the derived table `INFO/owner/todo_overzicht.md` was
# deleted. `tms_human_view.py` is still there, unused, in case it is ever needed.
