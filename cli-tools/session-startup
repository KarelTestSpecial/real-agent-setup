#!/bin/bash
# Session Startup: prime context + verify state
MEMANTO=~/bin/maccha/memanto_cli.py
echo "=== PRIME: loading context ==="
"$MEMANTO" prime 2>/dev/null
echo ""
echo "=== TMS check ==="
# Rule guard (CLAUDE.md 1.b): warns only on violations, otherwise one OK line.
TMS_OK=true
for f in ~/todo.md ~/in-progress.md; do
  if [ ! -f "$f" ]; then
    echo "⚠️  $f missing — broken symlink to BRAIN?"
    TMS_OK=false
    continue
  fi
  X_COUNT=$(grep -c '^- \[x\]' "$f")
  if (( X_COUNT > 0 )); then
    echo "⚠️  $f contains $X_COUNT finished [x] item(s) — move each as a single line to done.md now"
    TMS_OK=false
  fi
done
if [ -f ~/in-progress.md ]; then
  IP_OPEN=$(grep -c '^- \[[ /]\]' ~/in-progress.md)
  if (( IP_OPEN > 10 )); then
    echo "⚠️  in-progress.md has $IP_OPEN open items (max ±10) — prune back to todo.md"
    TMS_OK=false
  fi
fi
if $TMS_OK; then
  echo "TMS OK (todo: $(grep -c '^- \[[ /]\]' ~/todo.md) open, in-progress: $(grep -c '^- \[[ /]\]' ~/in-progress.md) open)"
fi

echo ""
# >>> LOCAL-ONLY (stripped by publish.sh — personal, non-generic block)
# SITUATIE_OVERZICHT has a half-life, not an update-trigger: keep its ⚠️ flag
# current every session (cheap, silent when OK), and explain only when stale.
if ! python3 ~/bin/maccha/situation_staleness_check.py --quiet >/dev/null 2>&1; then
  python3 ~/bin/maccha/situation_staleness_check.py --flag >/dev/null 2>&1
  python3 ~/bin/maccha/situation_staleness_check.py
  echo "   → Verify the stale claims, then update the 'Laatste update' date, or state that"
  echo "     the half-life should be raised. Do not silently leave the flag."
fi
# <<< LOCAL-ONLY

echo ""
# >>> LOCAL-ONLY (stripped by publish.sh — personal, non-generic block)
# Google tokens lie on expiry dates: an OAuth client can be deleted from its GCP
# project while the token still shows a valid expiry. So test access, don't read it.
if ! python3 ~/bin/maccha/google_access_check.py --quiet >/dev/null 2>&1; then
  python3 ~/bin/maccha/google_access_check.py --flag >/dev/null 2>&1
  python3 ~/bin/maccha/google_access_check.py
  echo "   → See ~/.config/maccha/GOOGLE_ACCESS.md for the recovery route. The Drive"
  echo "     tools are non-functional until an OAuth client is recreated."
fi
# <<< LOCAL-ONLY

echo ""
echo "=== Weekly TMS sweep (throttled, 1x per 7 days) ==="
SWEEP_MARKER=~/BRAIN/tms/.last_sweep
NOW=$(date +%s)
LAST=$(cat "$SWEEP_MARKER" 2>/dev/null || echo 0)
if (( NOW - LAST > 604800 )); then
  echo "$NOW" > "$SWEEP_MARKER"
  node ~/INFRA/maintenance/tms_prune.js
  echo "🧠 Pruning Memanto working memory (decayed Event noise)..."
  ~/bin/maccha/memanto_cli.py prune 2>/dev/null | grep -E 'Store:|Cleaned up' || true
  echo "⚠️  Weekly sweep due — manual steps for the agent:"
  echo "   move [x] items from todo/in-progress to done.md as single lines;"
  echo "   remove duplicates; in-progress.md max ±10 items; enforce the label format."
else
  echo "Last sweep $(( (NOW - LAST) / 86400 )) day(s) ago — OK."
fi

echo ""
echo "=== INBOX check ==="
# Untitled-1 = Karels permanente kladblok (zie INBOX/README.md) — nooit tellen of opruimen.
INBOX_N=$(find ~/INBOX -mindepth 1 -not -name 'README.md' -not -name 'Untitled-1' 2>/dev/null | wc -l)
if (( INBOX_N > 0 )); then
  echo "📥 INBOX contains $INBOX_N item(s) — process to owner locations and empty the folder:"
  find ~/INBOX -mindepth 1 -not -name 'README.md' -not -name 'Untitled-1' | head -10
else
  echo "INBOX empty (kladblok Untitled-1 = permanent, buiten beschouwing)."
fi

echo ""
echo "=== Weekly encrypted backup (throttled, 1x per 7 days) ==="
BK_MARKER=~/BRAIN/.last_backup
LASTB=$(cat "$BK_MARKER" 2>/dev/null || echo 0)
if (( NOW - LASTB > 604800 )); then
  echo "Backup due — starting in the background (log: ~/scratch/maccha-backup.log)"
  nohup ~/bin/maccha/maccha-backup > ~/scratch/maccha-backup.log 2>&1 &
else
  echo "Last backup $(( (NOW - LASTB) / 86400 )) day(s) ago — OK."
fi

echo ""
echo "=== Weekly link check (throttled, 1x per 7 days) ==="
# Guards knowledge files against link rot after folder reorganizations.
LC_MARKER=~/BRAIN/.last_linkcheck
LASTL=$(cat "$LC_MARKER" 2>/dev/null || echo 0)
if (( NOW - LASTL > 604800 )); then
  echo "$NOW" > "$LC_MARKER"
  LC_TARGETS=(~/BRAIN/AGENTS.md ~/BRAIN/tms/todo.md ~/BRAIN/tms/in-progress.md)
  # >>> LOCAL-ONLY (stripped by publish.sh — personal, non-generic block)
  LC_TARGETS+=(~/INFO/karel/SITUATIE_OVERZICHT.md ~/BRAIN/systeem-info/ROOT_REGISTER.md ~/BRAIN/systeem-info/TOOL_REGISTER.md)
  # <<< LOCAL-ONLY
  node ~/BRAIN/hooks/link-check.cjs "${LC_TARGETS[@]}" 2>/dev/null || echo "⚠️  link-check.cjs failed"
else
  echo "Last link check $(( (NOW - LASTL) / 86400 )) day(s) ago — OK."
fi

echo ""
# >>> LOCAL-ONLY (stripped by publish.sh — personal, non-generic block)
# <<< LOCAL-ONLY

echo ""
echo "=== Solucious weekly reminder (Saturday only) ==="
if [ "$(date +%u)" -eq 6 ]; then
  echo "🛒 Reminder: check Solucious order!"
else
  echo "Not Saturday — OK."
fi


