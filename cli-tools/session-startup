#!/bin/bash
# Session Startup: prime context + verify state
MEMANTO=~/bin/memanto_cli.py
echo "=== PRIME: laden van context ==="
"$MEMANTO" prime 2>/dev/null
echo ""
echo "=== TMS check ==="
# Regelbewaker (CLAUDE.md 1.b): waarschuwt alleen bij overtredingen, anders één OK-regel.
TMS_OK=true
for f in ~/todo.md ~/in-progress.md; do
  if [ ! -f "$f" ]; then
    echo "⚠️  $f ontbreekt — kapotte symlink naar BRAIN?"
    TMS_OK=false
    continue
  fi
  X_COUNT=$(grep -c '^- \[x\]' "$f")
  if (( X_COUNT > 0 )); then
    echo "⚠️  $f bevat $X_COUNT afgerond(e) [x]-item(s) — direct als één regel naar done.md verplaatsen"
    TMS_OK=false
  fi
done
if [ -f ~/in-progress.md ]; then
  IP_OPEN=$(grep -c '^- \[[ /]\]' ~/in-progress.md)
  if (( IP_OPEN > 10 )); then
    echo "⚠️  in-progress.md heeft $IP_OPEN open items (max ±10) — terugsnoeien naar todo.md"
    TMS_OK=false
  fi
fi
if $TMS_OK; then
  echo "TMS OK (todo: $(grep -c '^- \[[ /]\]' ~/todo.md) open, in-progress: $(grep -c '^- \[[ /]\]' ~/in-progress.md) open)"
fi

echo ""
echo "=== Wekelijkse TMS-sweep (throttled, 1x per 7 dagen) ==="
SWEEP_MARKER=~/BRAIN/tms/.last_sweep
NOW=$(date +%s)
LAST=$(cat "$SWEEP_MARKER" 2>/dev/null || echo 0)
if (( NOW - LAST > 604800 )); then
  echo "$NOW" > "$SWEEP_MARKER"
  node ~/INFRA/maintenance/tms_prune.js
  echo "⚠️  Wekelijkse sweep verschuldigd — handmatige stappen voor de agent:"
  echo "   [x]-items uit todo/in-progress als één regel naar done.md;"
  echo "   dubbels verwijderen; in-progress.md max ±10 items; labelvorm afdwingen."
else
  echo "Laatste sweep $(( (NOW - LAST) / 86400 )) dag(en) geleden — OK."
fi

echo ""
echo "=== INBOX check ==="
INBOX_N=$(find ~/INBOX -mindepth 1 -not -name 'README.md' 2>/dev/null | wc -l)
if (( INBOX_N > 0 )); then
  echo "📥 INBOX bevat $INBOX_N item(s) — verwerken naar eigenaar-locaties en leegmaken:"
  find ~/INBOX -mindepth 1 -not -name 'README.md' | head -10
else
  echo "INBOX leeg."
fi

echo ""
echo "=== Wekelijkse versleutelde backup (throttled, 1x per 7 dagen) ==="
BK_MARKER=~/BRAIN/.last_backup
LASTB=$(cat "$BK_MARKER" 2>/dev/null || echo 0)
if (( NOW - LASTB > 604800 )); then
  echo "Backup verschuldigd — start op achtergrond (log: ~/scratch/maccha-backup.log)"
  nohup ~/bin/maccha-backup > ~/scratch/maccha-backup.log 2>&1 &
else
  echo "Laatste backup $(( (NOW - LASTB) / 86400 )) dag(en) geleden — OK."
fi

echo ""
echo "=== Fable 5 / Mythos 5 toegang-watcher (recheck 1x per dag) ==="
FW_MARKER=~/BRAIN/.last_fable_check
LASTF=$(cat "$FW_MARKER" 2>/dev/null || echo 0)
if (( NOW - LASTF > 86400 )); then
  echo "$NOW" > "$FW_MARKER"
  ~/bin/fable-watch
fi
cat ~/BRAIN/.fable_status 2>/dev/null || echo "(nog geen status — draai ~/bin/fable-watch)"


echo ""
echo "=== Shortlist Sync Check ==="
if [ -f ~/bin/tms_shortlist_sync.py ]; then
  python3 ~/bin/tms_shortlist_sync.py
fi

# Leesbare todo-weergave verversen (afgeleid uit todo.md; stil, tenzij fout).
if [ -f ~/bin/tms_human_view.py ]; then
  python3 ~/bin/tms_human_view.py > /dev/null 2>&1 || echo "⚠️  tms_human_view.py faalde"
fi
