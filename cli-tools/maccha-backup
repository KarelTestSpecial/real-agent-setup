#!/bin/bash
# MACCHA encrypted backup of INFO/ PLAN/ BRAIN/ creatief/ to Google Drive.
# Triggered weekly via session-startup (marker ~/BRAIN/.last_backup);
# manual runs are always possible: ~/bin/maccha/maccha-backup
set -euo pipefail

H="${HOME:-/home/$(whoami)}"
DRIVE=/mnt/chromeos/GoogleDrive/MyDrive
DEST_DIR="$DRIVE/MACCHA-backups"
KEY_FILE="$H/.config/maccha/backup.key"
MARKER="$H/BRAIN/.last_backup"
# How many rotated backups to keep (1 = only the most recent).
KEEP=4
STAMP=$(date +%Y%m%d-%H%M)
OUT="$DEST_DIR/maccha-backup-$STAMP.tar.gz.enc"

if [ ! -d "$DRIVE" ]; then
  echo "❌ Google Drive not mounted at $DRIVE — share Drive with Linux via the Files app." >&2
  exit 1
fi
mkdir -p "$DEST_DIR"

if [ ! -f "$KEY_FILE" ]; then
  mkdir -p "$(dirname "$KEY_FILE")"
  umask 077
  openssl rand -hex 32 > "$KEY_FILE"
  echo "🔑 NEW key generated: $KEY_FILE"
  echo "   ⚠️  Store a copy OFF this device (password manager/paper) —"
  echo "   without this key the backup is worthless if the laptop is lost!"
fi

echo "📦 Creating backup → $OUT"
tar -C "$H" -czf - \
  --exclude='node_modules' --exclude='*/node_modules' \
  --exclude='BRAIN/archive/2026-06-mappenstructuur' \
  --exclude='.vite' \
  INFO PLAN BRAIN creatief \
| openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass file:"$KEY_FILE" -out "$OUT"

echo "🔍 Integrity check (decrypt + list tar contents)..."
openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass file:"$KEY_FILE" -in "$OUT" | tar -tzf - > /dev/null

SIZE=$(du -h "$OUT" | cut -f1)
echo "✅ Backup OK: $OUT ($SIZE)"

# Rotation: keep only the newest $KEEP backups
ls -1t "$DEST_DIR"/maccha-backup-*.tar.gz.enc 2>/dev/null | tail -n +$((KEEP+1)) | xargs -r rm -v

# Restore instructions next to the backups (without the key!)
cat > "$DEST_DIR/RESTORE.md" <<'EOF'
# Restoring a MACCHA backup

Contents: ~/INFO, ~/PLAN, ~/BRAIN, ~/creatief (without node_modules and old backups).

1. Put the key back on the (new) device:
   mkdir -p ~/.config/maccha && nano ~/.config/maccha/backup.key   # paste the 64-char hex key
   chmod 600 ~/.config/maccha/backup.key
2. Restore into the home directory:
   openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 \
     -pass file:~/.config/maccha/backup.key \
     -in maccha-backup-YYYYMMDD-HHMM.tar.gz.enc | tar -xzf - -C ~
The key is NOT stored in this folder — the owner keeps it separately (password manager/paper).
EOF

date +%s > "$MARKER"
echo "🗓️  Marker updated ($MARKER) — next automatic run in 7 days."
