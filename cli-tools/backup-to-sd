#!/bin/bash
# Backup of the local MACCHA rig to the SD card.
# Only what is truly unique locally: BRAIN, INFO, PLAN, scripts, dotfiles.
# Workspace projects are NOT backed up (they live on GitHub or can be recreated).

DEST_DIR="/mnt/chromeos/removable/SD Card/linux_home_backup"

echo "Starting MACCHA backup to SD card..."
echo "Target directory: $DEST_DIR"

rsync -rtP \
  --modify-window=2 \
  --delete-excluded \
  --exclude='.git/' \
  --exclude='.venv/' \
  --exclude='node_modules/' \
  --exclude='/BRAIN/archive/' \
  --include='/BRAIN/***' \
  --include='/INFO/***' \
  --include='/PLAN/***' \
  --include='/creatief/***' \
  --include='/bin/***' \
  --include='/scratch/***' \
  --include='/.ssh/***' \
  --include='/.bashrc' \
  --include='/.bash_aliases' \
  --include='/.gitconfig' \
  --include='/.profile' \
  --include='/.bash_history' \
  --include='/.npmrc' \
  --include='/*.md' \
  --exclude='/*' \
  "$HOME/" "$DEST_DIR/"

echo "Backup completed!"
