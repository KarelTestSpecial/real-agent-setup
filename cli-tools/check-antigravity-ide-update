#!/bin/bash
# ==============================================================================
# Script: check-antigravity-ide-update
# Doel: Controleert de actuele versie van Antigravity IDE ten opzichte van de
#       laatst beschikbare stabiele release, en biedt de optie om de upgrade
#       direct en veilig uit te voeren.
# ==============================================================================

# Kleuren voor UI
CYAN="\e[36m"
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
RED="\e[31m"
BOLD="\e[1m"
RESET="\e[0m"

echo -e "${CYAN}${BOLD}🔍 Antigravity IDE Update Checker & Installer${RESET}"
echo -e "======================================================================"

# 1. Bepaal de geïnstalleerde versie
PRODUCT_JSON="/opt/antigravity-ide/resources/app/product.json"
INSTALLED_VERSION="Niet geïnstalleerd"

if [ -f "$PRODUCT_JSON" ]; then
    # Lees ideVersion of fallback naar version
    INSTALLED_VERSION=$(jq -r '.ideVersion // .version' "$PRODUCT_JSON")
fi

echo -e "${BLUE}Geïnstalleerde versie:${RESET} ${BOLD}${INSTALLED_VERSION}${RESET}"

# 2. Haal de laatste beschikbare versie op via de API
API_URL="https://antigravity-ide-auto-updater-974169037036.us-central1.run.app/releases"
echo -e "${BLUE}Ophalen van release-informatie...${RESET}"

RELEASES_JSON=$(curl -sL "$API_URL")

if [ -z "$RELEASES_JSON" ] || [ "$RELEASES_JSON" == "[]" ]; then
    echo -e "${RED}❌ Fout: Kon geen verbinding maken met de update-server of geen releases gevonden.${RESET}"
    exit 1
fi

# De API geeft een gesorteerde JSON array terug. De eerste entry is de nieuwste release.
LATEST_VERSION=$(echo "$RELEASES_JSON" | jq -r '.[0].version')
EXEC_ID=$(echo "$RELEASES_JSON" | jq -r '.[0].execution_id')

echo -e "${BLUE}Laatste beschikbare versie:${RESET} ${BOLD}${LATEST_VERSION}${RESET}"

if [ "$INSTALLED_VERSION" == "Niet geïnstalleerd" ]; then
    echo -e "${YELLOW}⚠️ Antigravity IDE is momenteel niet correct geïnstalleerd op /opt/antigravity-ide.${RESET}"
    echo -e "Je kunt de nieuwste versie installeren met:"
    echo -e "  ${GREEN}update-antigravityide <pad-naar-tar.gz>${RESET}"
    exit 0
fi

# 3. Vergelijken en Rapporteren
if [ "$INSTALLED_VERSION" == "$LATEST_VERSION" ]; then
    echo -e "======================================================================"
    echo -e "${GREEN}✅ Je bent helemaal up-to-date! Er is geen actie vereist.${RESET}"
    echo -e "Huidige versie ${BOLD}${INSTALLED_VERSION}${RESET} is de nieuwste stabiele release."
    echo -e "======================================================================"
    exit 0
fi

echo -e "======================================================================"
echo -e "${YELLOW}🚀 UPDATE BESCHIKBAAR!${RESET}"
echo -e "Er is een nieuwe stabiele release van Antigravity IDE beschikbaar."
echo -e "  • Huidige versie : ${RED}${INSTALLED_VERSION}${RESET}"
echo -e "  • Nieuwe versie  : ${GREEN}${LATEST_VERSION}${RESET} (Build: ${EXEC_ID})"
echo ""

# Genereer de download-URL
DOWNLOAD_URL="https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/${LATEST_VERSION}-${EXEC_ID}/linux-x64/Antigravity%20IDE.tar.gz"

echo -e "${BLUE}Officiële Google CDN download-link:${RESET}"
echo -e "  ${CYAN}${DOWNLOAD_URL}${RESET}"
echo "======================================================================"

# Bied interactieve optie aan om de update direct uit te voeren
read -p "Wil je deze update nu automatisch downloaden en installeren? (j/n): " CONFIRM
CONFIRM=$(echo "$CONFIRM" | tr '[:upper:]' '[:lower:]')

if [[ "$CONFIRM" == "j" || "$CONFIRM" == "ja" || "$CONFIRM" == "y" || "$CONFIRM" == "yes" ]]; then
    echo -e "\n${CYAN}>> Starten van de geautomatiseerde upgrade...${RESET}"
    
    TEMP_ARCHIVE="$HOME/Downloads/Antigravity_IDE.tar.gz"
    
    echo -e "${BLUE}>> Downloaden van de nieuwste release naar ${TEMP_ARCHIVE}...${RESET}"
    if wget -O "$TEMP_ARCHIVE" "$DOWNLOAD_URL"; then
        echo -e "${GREEN}>> Download voltooid!${RESET}"
        
        echo -e "${BLUE}>> Starten van de installatie via update-antigravityide...${RESET}"
        if update-antigravityide "$TEMP_ARCHIVE"; then
            echo -e "${GREEN}>> Installatie met succes voltooid!${RESET}"
        else
            echo -e "${RED}❌ Fout: Installatie via update-antigravityide is mislukt.${RESET}"
            exit 1
        fi
        
        echo -e "${BLUE}>> Opschonen van tijdelijk archiefbestand...${RESET}"
        rm -f "$TEMP_ARCHIVE"
        echo -e "${GREEN}>> Opslag opgeruimd. Systeem is weer spik en span!${RESET}"
        echo -e "\n${GREEN}🎉 Antigravity IDE is succesvol geüpgraded naar versie ${LATEST_VERSION}!${RESET}"
    else
        echo -e "${RED}❌ Fout: Downloaden van update is mislukt.${RESET}"
        rm -f "$TEMP_ARCHIVE"
        exit 1
    fi
else
    echo -e "\n${YELLOW}Upgrade overgeslagen.${RESET} Je kunt dit later handmatig doen met:"
    echo -e "  ${GREEN}wget -O ~/Downloads/Antigravity_IDE.tar.gz \"${DOWNLOAD_URL}\"${RESET}"
    echo -e "  ${GREEN}update-antigravityide ~/Downloads/Antigravity_IDE.tar.gz${RESET}"
    echo -e "  ${GREEN}rm ~/Downloads/Antigravity_IDE.tar.gz${RESET}"
fi
echo -e "======================================================================"
