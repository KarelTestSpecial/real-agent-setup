#!/bin/bash
# maccha-doctor — one-shot health check for the MACCHA harness.
# Exit code: 0 = healthy (warnings allowed), 1 = at least one hard failure.
# Optional components (vdab-swipe, real-agent-setup) are skipped when absent.
#
# By default only harness-health sections are printed. Personal sections
# (job-hunt status, local project paths) require --local, so a screen-shared
# health check does not spill private context by accident.
set -uo pipefail

H="${HOME:-/home/$(whoami)}"
FAIL=0
WARN=0
SHOW_LOCAL=0

for arg in "$@"; do
  case "$arg" in
    --local) SHOW_LOCAL=1 ;;
    -h|--help)
      printf 'Usage: maccha-doctor [--local]\n'
      printf '  --local   also print personal/job-hunt sections (hidden by default)\n'
      exit 0 ;;
    *) printf 'Unknown option: %s (try --help)\n' "$arg"; exit 2 ;;
  esac
done

ok()      { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn()    { printf '  \033[33m⚠\033[0m %s\n' "$1"; WARN=$((WARN+1)); }
bad()     { printf '  \033[31m✗\033[0m %s\n' "$1"; FAIL=$((FAIL+1)); }
section() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# File mode as an octal string (e.g. 700). GNU stat spells it `-c`, BSD/macOS
# stat spells it `-f` — probe both instead of assuming an OS, so the secret
# permission check reports a real mode instead of "?" off-Linux.
file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

printf '\033[1m======================================================\033[0m\n'
printf '\033[1m  🩺 MACCHA DOCTOR\033[0m\n'
printf '\033[1m======================================================\033[0m\n'

section "Core zones"
for d in BRAIN INFO PLAN INBOX; do
  if [ -d "$H/$d" ]; then ok "$d/ present"; else bad "$d/ missing"; fi
done

section "Root symlinks"
for s in AGENTS.md IMPROVEMENT.md todo.md in-progress.md done.md; do
  if [ -L "$H/$s" ]; then
    if [ -e "$H/$s" ]; then ok "$s -> $(readlink "$H/$s")"; else bad "$s is a broken symlink"; fi
  elif [ -e "$H/$s" ]; then warn "$s is a regular file (not a symlink)"; else warn "$s missing"; fi
done

section "Backup"
MARK="$H/BRAIN/.last_backup"
KEY="$H/.config/maccha/backup.key"
if [ -f "$MARK" ]; then
  AGE=$(( ( $(date +%s) - $(cat "$MARK" 2>/dev/null || echo 0) ) / 86400 ))
  if [ "$AGE" -le 8 ]; then ok "last backup ${AGE}d ago"
  elif [ "$AGE" -le 14 ]; then warn "last backup ${AGE}d ago (>7d)"
  else bad "last backup ${AGE}d ago (>14d)"; fi
else warn "no backup marker yet"; fi
if [ -f "$KEY" ]; then ok "backup key present"; else warn "backup key missing"; fi
if [ -d /mnt/chromeos/GoogleDrive/MyDrive ]; then ok "Google Drive mounted"; else warn "Google Drive not mounted (backup target unavailable)"; fi

section "Secret permissions"
CFG="$H/.config/maccha"
if [ -d "$CFG" ]; then
  P=$(file_mode "$CFG")
  if [ "$P" = "700" ]; then ok "$CFG is 700"; else warn "$CFG is ${P:-?} (want 700)"; fi
fi
if [ -f "$KEY" ]; then
  P=$(file_mode "$KEY")
  if [ "$P" = "600" ]; then ok "backup.key is 600"; else warn "backup.key is ${P:-?} (want 600)"; fi
fi

section "TMS integrity"
HOOK="$H/bin/maccha/tms_integrity_hook.py"
if [ -f "$HOOK" ]; then
  if python3 "$HOOK" >/dev/null 2>&1; then ok "TMS integrity clean"; else bad "TMS integrity reported issues"; fi
else warn "tms_integrity_hook.py not found"; fi

section "Supply chain"
if [ -f "$H/.npmrc" ] && grep -q 'minimum-release-age' "$H/.npmrc"; then ok "minimum-release-age configured"; else warn "minimum-release-age not found in ~/.npmrc"; fi

section "Disk space"
FREE_KB=$(df -Pk "$H" 2>/dev/null | awk 'NR==2{print $4}')
if [ -n "${FREE_KB:-}" ]; then
  FREE_GB=$((FREE_KB / 1024 / 1024))
  if [ "$FREE_GB" -ge 2 ]; then ok "${FREE_GB}G free"; else warn "${FREE_GB}G free (<2G)"; fi
fi

if [ "$SHOW_LOCAL" -eq 1 ]; then
section "VDAB job-hunt (vdab-swipe)"
V="$H/workspace/vdab-swipe"
if [ -d "$V" ]; then
  # --- data layer: symlinks, because maccha-backup covers INFO/PLAN/BRAIN/C, not workspace/
  if [ -L "$V/data" ]; then
    if [ -e "$V/data" ]; then ok "data/ symlink resolves ($(readlink "$V/data"))"
    else bad "data/ is a symlink but the target is missing — swipe history gone!"; fi
  else warn "data/ is not a symlink (expected the backed-up store in INFO/)"; fi
  if [ -e "$V/chips.json" ]; then ok "chips.json reachable"
  else warn "chips.json missing — reason vocabulary not loaded"; fi

  # --- git + remote (same checks as real-agent-setup; this is now a repo with a remote)
  if [ -d "$V/.git" ]; then
    # `git status --porcelain`, not `git diff`: the latter misses untracked
    # files, and those are exactly what can leak personal data (gitignored files
    # such as data/ and chips.json are correctly ignored).
    UNCOMMITTED=$(git -C "$V" status --porcelain 2>/dev/null | head -20)
    if [ -z "$UNCOMMITTED" ]; then ok "working tree clean"
    else warn "uncommitted changes ($(git -C "$V" status --porcelain | wc -l)) — including untracked files:"; printf '        %s\n' "$UNCOMMITTED"; fi
    if git -C "$V" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      AHEAD=$(git -C "$V" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
      BEHIND=$(git -C "$V" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
      if [ "$AHEAD" = "0" ] && [ "$BEHIND" = "0" ]; then ok "in sync with origin"
      else warn "remote divergence: $AHEAD ahead, $BEHIND behind"; fi
    else warn "no upstream branch (no remote?)"; fi
    # The PII gate is a pre-commit hook and is NOT cloned along — it goes missing.
    [ -x "$V/.git/hooks/pre-commit" ] && ok "PII gate present (pre-commit)" \
      || warn "PII gate (pre-commit hook) missing — commits run without the PII check"
  else warn "not a git repo — changes are not revertable"; fi

  # --- pipeline
  if [ -f "$V/selftest.mjs" ]; then
    if (cd "$V" && node selftest.mjs >/dev/null 2>&1); then ok "pipeline selftest OK"; else bad "pipeline selftest FAILED"; fi
  else warn "selftest.mjs not found"; fi
  if [ -f "$V/data/features.json" ] && (cd "$V" && node validate-features.mjs >/dev/null 2>&1); then
    ok "feature-vectors schema-valid"
  else warn "features not validated (missing or invalid)"; fi
else
  # Not "skipped" any more: this project IS the jobhunt. A missing folder is a problem.
  warn "vdab-swipe missing — no job search, no swiping, no learning"
fi
else
  printf '\n\033[2m  (personal sections hidden — run "maccha-doctor --local" to include them)\033[0m\n'
fi

section "real-agent-setup (optional)"
R="$H/real-agent-setup"
if [ -d "$R/.git" ]; then
  if git -C "$R" diff --quiet && git -C "$R" diff --cached --quiet; then ok "working tree clean"; else warn "uncommitted changes present"; fi
  if git -C "$R" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    AHEAD=$(git -C "$R" rev-list --count '@{u}..HEAD')
    BEHIND=$(git -C "$R" rev-list --count 'HEAD..@{u}')
    if [ "$AHEAD" = "0" ] && [ "$BEHIND" = "0" ]; then ok "in sync with origin"; else warn "diverged (ahead $AHEAD, behind $BEHIND)"; fi
  fi
else ok "real-agent-setup not installed (skipped)"; fi

section "Broken symlinks in \$HOME (top level)"
# `find -xtype` is GNU-only and would abort this check on BSD/macOS; instead list
# every top-level symlink and test the target ourselves (an unresolved link is
# exactly what `-xtype l` matches).
BROKEN=$(find "$H" -maxdepth 1 -type l 2>/dev/null | while IFS= read -r l; do
  if [ ! -e "$l" ]; then printf '%s\n' "$l"; fi
done)
if [ -z "$BROKEN" ]; then ok "none"; else warn "found:"; printf '%s\n' "$BROKEN" | sed 's/^/     /'; fi

printf '\n\033[1m======================================================\033[0m\n'
if [ "$FAIL" -eq 0 ]; then
  printf '\033[32m\033[1m  ✅ HEALTH: OK\033[0m (%d warning(s))\n' "$WARN"
else
  printf '\033[31m\033[1m  ✗ HEALTH: %d FAILURE(S)\033[0m (%d warning(s))\n' "$FAIL" "$WARN"
fi
printf '\033[1m======================================================\033[0m\n'
exit $(( FAIL > 0 ))
