#!/bin/bash
# ==============================================================================
# Script: update-antigravitycli
# Description: Updates the Antigravity CLI (agy).
# ==============================================================================

set -e

echo "🔄 Updating Antigravity CLI (agy)..."

if [ -f "$HOME/.local/bin/agy" ]; then
    "$HOME/.local/bin/agy" update
else
    echo "⚠️ Error: agy binary not found at $HOME/.local/bin/agy"
    exit 1
fi

echo "✅ Antigravity CLI was updated successfully!"
